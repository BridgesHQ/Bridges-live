# Bridges Live — copy to .env and fill in. NEVER commit .env.
# Everything is optional: with nothing set the server runs fully locally
# (data/local-db.json + a PayPal sandbox simulator) so you can test right away.

PORT=3000
APP_URL=http://localhost:3000

# --- Supabase (free tier) — Project Settings → API ---
SUPABASE_URL=https://suwphgvhhohvvudkbiii.supabase.co
# the service_role / "secret" key (server only — never put this in a web page)
SUPABASE_SERVICE_KEY=
# For `npm run db:migrate`: Project Settings → Database → Connection string → Session pooler (URI)
DATABASE_URL=

# --- PayPal (sandbox is free) — developer.paypal.com → Apps & Credentials → Sandbox → your app ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# optional backup confirmation: add a webhook to your app pointing at <APP_URL>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# --- Admin (/admin login + Command Center). Pick a long random string. ---
ADMIN_TOKEN=

# --- Behaviour ---
# show seeded audience sizes on top of real connected viewers (turn off in production)
DEMO_MODE=true
# new "Go Live" streams appear immediately (false = wait for admin approval)
AUTO_APPROVE_STREAMS=true

# ======================= LEAD PIPELINE =======================
# Each integration turns on as soon as its keys are filled. See docs/LEAD_PIPELINE.md.
# WhatsApp number lives in assets/js/site-config.js (whatsappNumber) — or set WHATSAPP_NUMBER here.
WHATSAPP_NUMBER=
LEAD_ALERT_EMAIL=           # where new-lead emails go, e.g. dd@bridgesglobal.co
BUSINESS_ADDRESS=           # mailing address shown in follow-up emails (CAN-SPAM)
CRON_SECRET=                # random string; cron-job.org calls POST /api/cron/followups with it

# HubSpot private app token may also be set as HUBSPOT_ACCESS_TOKEN

# Resend (free: 3,000 emails/month) — verify bridgesglobal.co in Resend first
RESEND_API_KEY=
RESEND_FROM=Dorota Maslowska <dd@bridgesglobal.co>

# CRM — fill ONE (or both)
HUBSPOT_TOKEN=              # HubSpot private app token (scopes: crm.objects.contacts.read + write)
GHL_WEBHOOK_URL=            # GoHighLevel workflow "Inbound Webhook" trigger URL
CRM_WEBHOOK_URL=            # any other CRM / Zapier / Make webhook

LEAD_SEQUENCE_ENABLED=true  # 5-touch follow-up (turn off if GoHighLevel runs the follow-up instead)

# ======================= CLOUDFLARE STREAM (many agents live at once) =======================
# Paid: about $5/mo minimum (per 1,000 minutes stored + 1,000 minutes watched). See docs/LIVE_STREAMING.md.
CF_ACCOUNT_ID=              # dash.cloudflare.com → right sidebar "Account ID"
CF_STREAM_TOKEN=            # My Profile → API Tokens → Create → permission "Account · Stream · Edit"
CF_SUBDOMAIN=               # Stream → any video → "customer-XXXX.cloudflarestream.com" (paste whole thing or XXXX)
SHOW_SEED_STREAMS=false     # true only for local demos (shows fake property streams)

# ======================= TODAY'S CONTENT (daily video scripts) =======================
ANTHROPIC_API_KEY=          # console.anthropic.com → API Keys. Empty = built-in templates.
CONTENT_EMAIL_HOUR=7        # Today's Content is emailed to LEAD_ALERT_EMAIL at/after this hour (Tampa time)
ANTHROPIC_MODEL=             # optional: override the default model
VIDEO_PROVIDER=             # later: webhook | higgsfield  (see docs/CONTENT.md)
VIDEO_WEBHOOK_URL=
HIGGSFIELD_API_KEY=

# ======================= REAL LISTINGS (homepage "Homes for sale") =======================
BRIDGE_API_SERVER_TOKEN=    # Stellar MLS data agreement → Bridge Interactive "Server token" (best)
BRIDGE_DATASET=stellar
LISTING_CITIES=Tampa;Riverview;Brandon;Apollo Beach;Wesley Chapel;Parrish;Lithia;Ruskin
REALTYAPI_KEY=              # fallback only, used when the MLS token isn't set
LOFTY_SEARCH_URL=https://bridgesglobal.co   # "Search every MLS home" button

# ======================= SOCIAL VIDEOS IN THE STREAM GRID =======================
YOUTUBE_API_KEY=            # Google Cloud → YouTube Data API v3 → API key
YOUTUBE_HANDLE=             # optional — or type it in /admin → Videos → Connect YouTube
INSTAGRAM_APP_ID=           # Meta app → Instagram API with Instagram Login → "Connect Instagram" button in /admin
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=     # optional alternative: paste a generated token instead of using Connect
TIKTOK_CLIENT_KEY=          # developers.tiktok.com app (Login Kit + Display API: user.info.basic, video.list)
TIKTOK_CLIENT_SECRET=       # then /admin → Videos & recordings → Connect TikTok
