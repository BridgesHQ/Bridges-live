# ListingReel — copy to .env.local (local) or paste into Vercel → Settings → Environment Variables.
# Same Supabase project as Bridges Live.

# --- required to run at all ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://suwphgvhhohvvudkbiii.supabase.co
# Supabase → Settings → API Keys → Publishable key (sb_publishable_…) — safe in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase → Settings → API Keys → Secret key (sb_secret_…) — server only
SUPABASE_SERVICE_ROLE_KEY=

# --- AI scripts (console.anthropic.com → API keys; pay-per-use, no free tier) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- video rendering (creatomate.com → free trial credits) ---
CREATOMATE_API_KEY=
CREATOMATE_TEMPLATE_ID=

# --- billing (stripe.com → test mode is free). Leave empty to let everyone use the app free while testing. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_TRIAL_DAYS=7

# --- daily render check (any random string, 16+ characters) ---
CRON_SECRET=

# --- social posting (later — needs each platform's app review) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
